# Resend API key (https://resend.com/api-keys)
# Required for the contact form (POST /api/contact)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# From address. Until fastscraping.com is verified in Resend, use the shared
# onboarding sender (delivers only to your Resend account email).
#   After verifying the domain: CONTACT_FROM="Fastscraping <notes@fastscraping.com>"
CONTACT_FROM="Fastscraping <onboarding@resend.dev>"

# Recipient. Until the domain is verified this must be your Resend account email.
CONTACT_TO=khalid@fastscraping.com

# ---- Client usage dashboard (/dashboard) ----
SCRAPE_API_BASE=http://86.48.2.59:8040
# iron-session cookie encryption key — at least 32 chars. e.g. openssl rand -base64 32
SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars

# Google OAuth — create an OAuth 2.0 Client (Web) in Google Cloud.
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback (dev)
#   and https://www.fastscraping.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Billing (/dashboard/billing) ----
# Credit packs shown with a "Buy with card" button. Each url is a Stripe
# Payment Link (public URL, no Stripe secret needed). Unset = quote-based plans.
# BILLING_PACKS=[{"id":"s10","name":"Starter","credits":"10,000 requests","price":"$50","url":"https://buy.stripe.com/xxx"}]
BILLING_PACKS=
# Support requests from the dashboard go here (default support@fastscraping.com).
SUPPORT_TO=support@fastscraping.com

# ---- Self-serve trial key (one per account) ----
# Stays off unless TRIAL_ENABLED=1 and the three values below are set.
TRIAL_ENABLED=0
TRIAL_SERVICE_SLUG=shopee-pdp-compose-get-pc
TRIAL_ADMIN_URL=
TRIAL_ADMIN_TOKEN=
TRIAL_QUOTA=200
TRIAL_PER_MINUTE=20
TRIAL_PER_HOUR=200
TRIAL_PER_DAY=200
TRIAL_CONCURRENCY=10

# ---- Wallet / Stripe (card top-up) ----
# Card top-up is OFF until both are set. Use a RESTRICTED key (rk_...) with
# "Checkout Sessions: Write" only. Webhook endpoint:
#   https://www.fastscraping.com/api/stripe/webhook  (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WALLET_MIN_USD=50
WALLET_MAX_USD=5000
WALLET_PRESETS=100,250,500,1000
# Who gets the "card top-up received" email (default CONTACT_TO)
BILLING_NOTIFY_TO=
