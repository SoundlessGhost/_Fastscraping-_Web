// Fastscraping dashboard data model.
// The connection URL lives in prisma.config.ts (env DATABASE_URL) — Prisma 7
// no longer accepts `url` here.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CodePurpose {
  SIGNUP
  RESET
}

enum ServiceStatus {
  ACTIVE
  DISABLED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum ClientServiceStatus {
  ACTIVE
  DISABLED
}

/// A dashboard account. Signup is open; role decides admin vs client.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  company      String?
  /// Bumped on every avatar upload; used as a cache-buster in the image URL so
  /// a new picture shows up immediately instead of sitting behind a cached one.
  avatarUpdatedAt DateTime?
  role                 Role       @default(CLIENT)
  status               UserStatus @default(ACTIVE)
  emailVerifiedAt      DateTime?
  /// When the password was last changed. Kept for the record only — the old
  /// "once every 30 days" lock was removed (2026-07-19).
  lastPasswordChangeAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  clientServices ClientService[]
  sessions       Session[]
  auditLogs      AuditLog[]      @relation("actor")
  avatar         Avatar?

  @@index([role])
}

/// Profile picture, in its own table so that loading a User never drags the
/// image bytes along. Uploads are accepted up to 10 MB but stored re-encoded
/// to a small square, so what actually lands here is a few tens of KB.
model Avatar {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Short-lived 6-digit codes emailed for signup verification and password reset.
/// Only the hash is stored, never the code itself.
model EmailCode {
  id        String      @id @default(cuid())
  email     String
  codeHash  String
  purpose   CodePurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// A backend we proxy to — one row per running endpoint (its own host:port and
/// its own API key). The four taxonomy columns are what the sidebar nests by:
///   category -> platform -> region -> endpoint
/// A row may stop short (region/endpoint null) when one key covers a whole
/// platform. `kind` selects the response adapter; `capabilities` drives which
/// UI widgets show.
model Service {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  category String
  platform String
  region   String?
  endpoint String?

  baseUrl String
  /// Where usage lives on that backend, and which header carries the key —
  /// per-service so a new backend needs no code change.
  usagePath  String @default("/me/usage")
  authHeader String @default("X-API-Key")

  kind         String        @default("generic")
  capabilities Json?
  status       ServiceStatus @default(ACTIVE)
  sortOrder    Int           @default(0)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  clientServices ClientService[]

  @@index([category, platform])
  @@index([status])
}

/// The join that makes multi-service work: which client holds which API key
/// for which backend. The key is encrypted at rest (AES-256-GCM).
model ClientService {
  id        String              @id @default(cuid())
  userId    String
  serviceId String
  apiKeyEnc String
  label     String?
  status    ClientServiceStatus @default(ACTIVE)
  /// The backend is the source of truth for whether a key is valid; these two
  /// only cache the last answer so the UI can say "key rejected, update it".
  verifiedAt DateTime?
  lastError  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
}

/// Server-side session records so an admin can revoke access / log a user out.
model Session {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Failed-login ledger for rate limiting. One row per failed attempt, keyed by
/// "email:<addr>" (throttles a single account being brute-forced) and
/// "ip:<addr>" (throttles one source spraying many accounts). Rows age out of a
/// short window and are pruned opportunistically, so this table stays small.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/// A billable invoice we send a client for scraping usage. The public page lives
/// at /invoice/{id}/{token}; the token is an unguessable secret so the URL can
/// be shared without anyone enumerating other clients' invoices. Payment is a
/// plain link to an SSLCommerz page the admin pastes in — this row just displays
/// the bill and links out.
model Invoice {
  id            String        @id @default(cuid())
  /// URL secret — required to view; wrong/missing => 404.
  token         String
  /// Human-facing number, e.g. INV-8F3A2C. Unique for reference.
  number        String        @unique
  clientName    String
  clientEmail   String?
  clientAddress String?
  /// Line items: [{ description, quantity, unitPrice }] in `currency`.
  items         Json
  currency      String        @default("USD")
  /// Flat tax added on top of the line-item subtotal (0 = none).
  taxAmount     Float         @default(0)
  notes         String?
  status        InvoiceStatus @default(UNPAID)
  /// The SSLCommerz payment URL the "Proceed to Payment" button opens.
  paymentUrl    String?
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
}

/// Trail of admin/user actions.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}
